{
  "name": "@kinde-oss/kinde-convex-agent-auth",
  "description": "Agent identity, delegation and authorization Convex component backed by Kinde.",
  "repository": "github:kinde-oss/kinde-convex-agent-auth",
  "homepage": "https://github.com/kinde-oss/kinde-convex-agent-auth#readme",
  "bugs": {
    "url": "https://github.com/kinde-oss/kinde-convex-agent-auth/issues"
  },
  "version": "0.1.0",
  "license": "MIT",
  "keywords": [
    "convex",
    "component",
    "kinde",
    "agent",
    "authorization",
    "m2m"
  ],
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'npm run dev:build'",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'npm run build:codegen' --initial",
    "predev": "npm run build:codegen",
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "convex codegen --component-dir ./src/component && npm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p example/convex",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:coverage": "vitest run --coverage --coverage.reporter=text"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "dependencies": {
    "convex-helpers": "^0.1.104",
    "jose": "^6.0.0"
  },
  "peerDependencies": {
    "convex": "^1.41.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "9.39.4",
    "@types/node": "^24.12.2",
    "chokidar-cli": "3.0.0",
    "convex": "^1.41.0",
    "convex-test": "^0.0.53",
    "eslint": "9.39.4",
    "globals": "^17.5.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.2",
    "vitest": "4.1.4"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js"
}
